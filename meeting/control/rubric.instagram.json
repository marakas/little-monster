{
  "scenario": "Instagram",
  "weights": {
    "requirements": 0.15,
    "data_model": 0.15,
    "media_pipeline": 0.2,
    "feed_generation": 0.2,
    "caching": 0.1,
    "scale_reliability": 0.1,
    "observability": 0.05,
    "security": 0.05
  },
  "checks": [
    {
      "id": "requirements.nfr",
      "label": "NFRs: scale & latency",
      "look_for": ["DAU estimate", "peak QPS", "p50/p95 feed latency"],
      "expected_ranges": {
        "DAU": [50000000, 1000000000],
        "feed_p50_ms": [0, 200]
      },
      "score_anchors": {
        "0": "No mention of scale or latency.",
        "3": "Mentions DAU or latency without concrete ranges or trade-offs.",
        "5": "States plausible DAU + peak QPS + latency targets and ties them to design choices."
      }
    },
    {
      "id": "data.model",
      "label": "Data model & indices",
      "look_for": [
        "users",
        "posts",
        "follows",
        "likes",
        "comments",
        "indices",
        "hot keys"
      ],
      "score_anchors": {
        "0": "Vague or missing.",
        "3": "Covers main entities but lacks indices/hot keys/partitioning considerations.",
        "5": "Solid entities + indices + hot keys, partitioning/sharding plan called out."
      }
    },
    {
      "id": "media.pipeline",
      "label": "Media pipeline",
      "must_cover": [
        "upload",
        "virus_scan",
        "transcode variants",
        "metadata store",
        "CDN"
      ],
      "score_anchors": {
        "0": "Missing or hand-wavy.",
        "3": "Covers most steps without failure/backpressure detail.",
        "5": "End-to-end with backpressure, retries, idempotency, CDN caching strategy."
      }
    },
    {
      "id": "feed.strategy",
      "label": "Feed generation & ranking",
      "look_for": [
        "push vs pull",
        "fanout/fanin",
        "ranking signals",
        "pagination"
      ],
      "score_anchors": {
        "0": "Not addressed.",
        "3": "Mentions approach but thin on trade-offs or scaling.",
        "5": "Clear strategy with trade-offs, pagination, cold-start and scale considerations."
      }
    },
    {
      "id": "caching.strategy",
      "label": "Caching & invalidation",
      "look_for": ["CDN", "edge caching", "Redis timelines", "invalidation"],
      "score_anchors": {
        "0": "Missing.",
        "3": "Mentions caching but not invalidation/consistency.",
        "5": "Coherent multi-layer caching + invalidation approach tied to feed correctness."
      }
    },
    {
      "id": "scale.reliability",
      "label": "Scale & reliability",
      "look_for": [
        "sharding",
        "backpressure",
        "rate limits",
        "queues",
        "retries",
        "idempotency"
      ],
      "score_anchors": {
        "0": "Missing.",
        "3": "Some mechanisms mentioned without integration.",
        "5": "Robust strategy with concrete mechanisms for failure modes and load."
      }
    },
    {
      "id": "observability",
      "label": "Observability",
      "look_for": ["metrics", "traces", "alerts", "SLOs", "degradation levers"],
      "score_anchors": {
        "0": "Missing.",
        "3": "Mentions metrics/alerts.",
        "5": "Metrics+tracing+SLOs and explicit degradation switches."
      }
    },
    {
      "id": "security.privacy",
      "label": "AuthN/Z & abuse mitigation",
      "look_for": ["authN/Z", "PII handling", "rate limits", "moderation"],
      "score_anchors": {
        "0": "Missing.",
        "3": "Basic authN/Z only.",
        "5": "Covers authN/Z, PII basics, abuse mitigation, throttling and privacy."
      }
    }
  ]
}
