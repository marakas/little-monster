<section class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2">
  <div class="flex flex-col justify-between">
    <a href="/login" class="inline-flex items-center gap-2 text-gray-500 hover:text-gray-800">
      <span class="material-symbols-outlined">arrow_back</span> Return to Log In
    </a>

    <div class="my-8">
      <h1 class="text-4xl font-extrabold leading-tight">
        Start your 15-minute
        <span class="text-blue-600">Japanese</span>
        lesson
      </h1>
      <p class="mt-3 text-lg text-gray-600">
        We’ll pre-generate a 3×5-minute session (vocab, listening, conversation) based on your choices.
      </p>
    </div>
  </div>

  <div class="relative">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <%- await include("flash", { error, success }) %>
      <form method="post" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold mb-1" for="name">Name</label>
          <input class="w-full rounded-lg border border-gray-300 px-3 py-2" id="name" name="name" placeholder="John Doe" value="<%= values?.name || '' %>" required />
        </div>

        <div>
          <label class="block text-sm font-semibold mb-1" for="email">Email</label>
          <input class="w-full rounded-lg border border-gray-300 px-3 py-2" id="email" name="email" type="email" placeholder="you@example.com" value="<%= values?.email || '' %>" required />
        </div>

        <div>
          <label class="block text-sm font-semibold mb-1" for="password">Password</label>
          <input class="w-full rounded-lg border border-gray-300 px-3 py-2" id="password" name="password" type="password" placeholder="Create a password" required />
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label class="block text-sm font-semibold mb-1" for="level">Level</label>
            <select id="level" name="level" class="w-full rounded-lg border border-gray-300 px-3 py-2">
              <% levels.forEach(l => { %>
                <option value="<%= l %>" <%= (values?.level===l ? 'selected' : '') %>><%= l %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-1" for="focus">Focus</label>
            <select id="focus" name="focus" class="w-full rounded-lg border border-gray-300 px-3 py-2">
              <% focuses.forEach(f => { %>
                <option value="<%= f %>" <%= (values?.focus===f ? 'selected' : '') %>><%= f %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold mb-1" for="notes">What do you want from this lesson?</label>
          <textarea id="notes" name="notes" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2" placeholder="e.g., I want a polite keigo intro for client calls"><%= values?.notes || '' %></textarea>
        </div>

        <button class="w-full rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700">
          Create account & prepare my lesson
        </button>
      </form>

      <p class="mt-4 text-sm text-gray-600">
        Already have an account? <a class="text-blue-600 hover:underline" href="/login">Log in</a>.
      </p>
    </div>
  </div>
</section>