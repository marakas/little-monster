<section class="mx-auto max-w-6xl">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-extrabold">Welcome, <%= user.email %></h1>
    <a class="text-sm text-gray-600 hover:underline" href="/logout">Log out</a>
  </div>

  <p class="mt-3 text-gray-600">
    We’ll pre-generate your 15-minute lesson assets (vocab, listening,
    conversation) in the background. When they’re ready, your Meet bot can pull
    the script/audio from S3 + DB.
  </p>

  <div class="mt-8">
    <h2 class="text-xl font-bold mb-3">Your recent lesson requests</h2>
    <div class="grid gap-3">
      <% if (!lessons.length) { %>
      <div class="rounded-lg border border-gray-200 bg-white p-4 text-gray-600">
        No lesson requests yet.
      </div>
      <% } %> <% lessons.forEach(l => { %>
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div class="flex items-center justify-between">
          <div class="font-semibold capitalize">
            <%= l.level %> · <%= l.focus %>
          </div>
          <div class="text-sm text-gray-500">
            <%= new Date(l.created_at).toLocaleString() %>
          </div>
        </div>
        <% if (l.notes) { %>
        <div class="mt-1 text-gray-700 text-sm"><%= l.notes %></div>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
</section>
